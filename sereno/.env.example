# Copie este arquivo para ".env" (na raiz do projeto, junto do pom.xml).
# NADA aqui é obrigatório: sem .env a API sobe com H2 em memória.
# Para usar uma variável, TIRE o "#" do começo da linha e preencha o valor.
# NÃO deixe variáveis vazias (ex.: "OPENAI_API_KEY="): apague ou comente a linha.
# Escreva os valores SEM aspas e sem espaço no fim da linha.

# ---------- JWT HS256 (32+ caracteres). Sem ele a API gera um segredo aleatório por execução. ----------
#JWT_SECRET=troque-por-um-segredo-forte-com-32-ou-mais-caracteres

# ---------- RabbitMQ (estes já são os valores padrão) ----------
#RABBITMQ_HOST=localhost
#RABBITMQ_PORT=5672
#RABBITMQ_USERNAME=guest
#RABBITMQ_PASSWORD=guest

# ---------- Somente para o perfil "oracle" (--spring.profiles.active=oracle) ----------
#DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
#DB_USERNAME=RM000000
#DB_PASSWORD=sua_senha_do_oracle
